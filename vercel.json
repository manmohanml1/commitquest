{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "angular",
  "installCommand": "npm ci --ignore-scripts --no-audit --no-fund",
  "buildCommand": "npm run build",
  "outputDirectory": "apps/web/dist/commitquest-web/browser",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://commitquest-api-manmohanml1.onrender.com/api/:path*"
    }
  ]
}
